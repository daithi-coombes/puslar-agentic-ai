{
  "name": "agentic-ai",
  "main": "./lib/agentic-ai",
  "version": "0.3.0",
  "description": "Local AI coding assistant using Ollama & in memory RAG vector db for context.",
  "keywords": [
    "ai",
    "ollama",
    "code-assistance",
    "rag",
    "embeddings",
    "llm",
    "chromadb",
    "transformers"
  ],
  "activationCommands": {
    "atom-workspace": "agentic-ai:toggle"
  },
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    }
  },
  "repository": "https://github.com/daithi-coombes/puslar-agentic-ai",
  "license": "MIT",
  "engines": {
    "atom": ">=1.131.0"
  },
  "deserializers": {
    "agentic-ai/AgenticAiView": "deserializeAgenticAiView"
  },
  "configSchema": {
    "providers": {
      "type": "object",
      "title": "Providers",
      "description": "Connection settings for each model provider.",
      "order": 1,
      "properties": {
        "ollama": {
          "type": "object",
          "title": "Ollama",
          "description": "Local LLM server — serves both embedding and LLM models.",
          "order": 1,
          "properties": {
            "enabled": {
              "title": "Enabled",
              "type": "boolean",
              "default": true,
              "order": 0
            },
            "baseUrl": {
              "title": "Base URL",
              "description": "Ollama API endpoint.",
              "type": "string",
              "default": "http://127.0.0.1:11434",
              "order": 1
            },
            "requestTimeout": {
              "title": "Request Timeout (ms)",
              "type": "integer",
              "default": 120000,
              "minimum": 5000,
              "order": 2
            },
            "keepAlive": {
              "title": "Keep Alive",
              "description": "How long Ollama keeps a model loaded (e.g. \"5m\", \"1h\", \"0\").",
              "type": "string",
              "default": "5m",
              "order": 3
            }
          }
        },
        "transformers": {
          "type": "object",
          "title": "Transformers (HuggingFace)",
          "description": "Runs embedding models in-process via Transformers.js — no server needed.",
          "order": 2,
          "properties": {
            "enabled": {
              "title": "Enabled",
              "type": "boolean",
              "default": false,
              "order": 0
            },
            "device": {
              "title": "Device",
              "type": "string",
              "default": "cpu",
              "enum": [
                "cpu",
                "gpu"
              ],
              "order": 1
            },
            "dtype": {
              "title": "Data Type",
              "type": "string",
              "default": "fp32",
              "enum": [
                "fp32",
                "fp16",
                "int8"
              ],
              "order": 2
            }
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "title": "Defaults",
      "description": "Default selections when opening a new session.",
      "order": 2,
      "properties": {
        "embedProvider": {
          "title": "Default Embed Provider",
          "type": "string",
          "default": "ollama",
          "enum": [
            "ollama",
            "transformers"
          ],
          "order": 1
        },
        "embedModel": {
          "title": "Default Embed Model",
          "type": "string",
          "default": "nomic-embed-text",
          "order": 2
        },
        "llmProvider": {
          "title": "Default LLM Provider",
          "type": "string",
          "default": "ollama",
          "enum": [
            "ollama"
          ],
          "order": 3
        },
        "llmModel": {
          "title": "Default LLM Model",
          "type": "string",
          "default": "deepseek-coder",
          "order": 4
        }
      }
    },
    "chunkers": {
      "type": "object",
      "title": "Chunkers",
      "order": 3,
      "properties": {
        "default": {
          "title": "Default Chunker",
          "type": "string",
          "default": "treesitter",
          "enum": [
            "treesitter",
            "recursive-character",
            "markdown"
          ],
          "order": 1
        },
        "chunkSize": {
          "title": "Chunk Size (tokens)",
          "type": "integer",
          "default": 1500,
          "minimum": 100,
          "maximum": 10000,
          "order": 2
        },
        "chunkOverlap": {
          "title": "Chunk Overlap (tokens)",
          "type": "integer",
          "default": 200,
          "minimum": 0,
          "maximum": 2000,
          "order": 3
        }
      }
    },
    "vectorDBs": {
      "type": "object",
      "title": "Vector Database",
      "order": 4,
      "properties": {
        "default": {
          "title": "Default Vector DB",
          "type": "string",
          "default": "chromadb",
          "enum": [
            "chromadb"
          ],
          "order": 1
        },
        "chromadbUrl": {
          "title": "ChromaDB URL",
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "order": 2
        },
        "collection": {
          "title": "Collection Name",
          "type": "string",
          "default": "agentic-ai",
          "order": 3
        },
        "distanceMetric": {
          "title": "Distance Metric",
          "type": "string",
          "default": "cosine",
          "enum": [
            "cosine",
            "l2",
            "ip"
          ],
          "order": 4
        }
      }
    },
    "search": {
      "type": "object",
      "title": "Search",
      "order": 5,
      "properties": {
        "topK": {
          "title": "Top K Results",
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "order": 1
        },
        "scoreThreshold": {
          "title": "Score Threshold",
          "type": "number",
          "default": 0.65,
          "minimum": 0,
          "maximum": 1,
          "order": 2
        }
      }
    },
    "indexing": {
      "type": "object",
      "title": "Indexing",
      "order": 6,
      "properties": {
        "include": {
          "title": "Include Patterns",
          "type": "array",
          "default": [
            "**/*.js",
            "**/*.mjs",
            "**/*.ts",
            "**/*.py",
            "**/*.jsx",
            "**/*.tsx"
          ],
          "items": {
            "type": "string"
          },
          "order": 1
        },
        "exclude": {
          "title": "Exclude Patterns",
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/coverage/**",
            "**/.git/**",
            "**/build/**"
          ],
          "items": {
            "type": "string"
          },
          "order": 2
        },
        "batchSize": {
          "title": "Batch Size",
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 500,
          "order": 3
        },
        "cacheDir": {
          "title": "Embeddings Cache Directory",
          "type": "string",
          "default": "~/.pulsar/packages/agentic-ai/embeddings_cache",
          "order": 4
        }
      }
    }
  },
  "dependencies": {
    "axios": "^1.13.5",
    "ollama": "^0.6.3",
    "rag-codebase-indexer": "file:../../Workspace/daithi-coombes/rag-codebase-indexer"
  },
  "devDependencies": {
    "atom-jasmine3-test-runner": "^5.2.13",
    "electron-rebuild": "^3.2.9",
    "nyc": "^18.0.0"
  },
  "atomTestRunner": "./spec/custom-runner",
  "scripts": {
    "test": "pulsar --test spec",
    "test:coverage": "COVERAGE=1 pulsar --test spec",
    "docker-up": "docker-compose -f docker-compose-fast.yml up -d",
    "docker-down": "docker-compose -f docker-compose-fast.yml down"
  }
}
