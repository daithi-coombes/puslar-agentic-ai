{
  "$schema": "./agentic-ai.config.schema.json",
  "$version": "0.3.0",

  "providers": {
    "ollama": {
      "label": "Ollama",
      "description": "Local LLM server via Ollama REST API",
      "connection": {
        "baseUrl": "http://127.0.0.1:11434",
        "requestTimeout": 120000,
        "keepAlive": "5m"
      },
      "models": {
        "nomic-embed-text": {
          "type": "embed",
          "dimensions": 768,
          "maxTokens": 2048
        },
        "mxbai-embed-large": {
          "type": "embed",
          "dimensions": 1024,
          "maxTokens": 512
        },
        "all-minilm": {
          "type": "embed",
          "dimensions": 384,
          "maxTokens": 512
        },
        "snowflake-arctic-embed": {
          "type": "embed",
          "dimensions": 1024,
          "maxTokens": 512
        },
        "bge-m3": {
          "type": "embed",
          "dimensions": 1024,
          "maxTokens": 8192
        },
        "bge-large": {
          "type": "embed",
          "dimensions": 1024,
          "maxTokens": 512
        },
        "embeddinggemma": {
          "type": "embed",
          "dimensions": 768,
          "maxTokens": 2048
        },
        "qwen3-embedding": {
          "type": "embed",
          "dimensions": 1024,
          "maxTokens": 32768
        },
        "deepseek-coder": {
          "type": "llm",
          "contextWindow": 16384,
          "temperature": 0.7
        },
        "deepseek-r1": {
          "type": "llm",
          "contextWindow": 16384,
          "temperature": 0.7
        },
        "llama3": {
          "type": "llm",
          "contextWindow": 8192,
          "temperature": 0.8,
          "maxTokens": 4096
        },
        "llama3.1": {
          "type": "llm",
          "contextWindow": 131072,
          "temperature": 0.7,
          "maxTokens": 4096
        },
        "llama3.2": {
          "type": "llm",
          "contextWindow": 131072,
          "temperature": 0.7,
          "maxTokens": 4096
        },
        "codellama": {
          "type": "llm",
          "contextWindow": 16384,
          "temperature": 0.5,
          "maxTokens": 4096
        },
        "mistral": {
          "type": "llm",
          "contextWindow": 32768,
          "temperature": 0.7
        },
        "mixtral": {
          "type": "llm",
          "contextWindow": 32768,
          "temperature": 0.7
        },
        "gemma3": {
          "type": "llm",
          "contextWindow": 8192,
          "temperature": 0.7
        },
        "qwen2.5": {
          "type": "llm",
          "contextWindow": 32768,
          "temperature": 0.7
        },
        "qwen3": {
          "type": "llm",
          "contextWindow": 32768,
          "temperature": 0.7
        },
        "phi3": {
          "type": "llm",
          "contextWindow": 4096,
          "temperature": 0.7
        },
        "starcoder2": {
          "type": "llm",
          "contextWindow": 16384,
          "temperature": 0.5
        },
        "command-r": {
          "type": "llm",
          "contextWindow": 131072,
          "temperature": 0.7
        }
      }
    },

    "transformers": {
      "label": "Transformers",
      "description": "HuggingFace Transformers.js — runs in-process, no server needed",
      "connection": {
        "device": "cpu",
        "dtype": "fp32"
      },
      "models": {
        "Xenova/all-MiniLM-L6-v2": {
          "type": "embed",
          "dimensions": 384,
          "maxTokens": 512,
          "quantized": true
        },
        "Xenova/bge-small-en-v1.5": {
          "type": "embed",
          "dimensions": 384,
          "maxTokens": 512,
          "quantized": true
        },
        "Xenova/all-mpnet-base-v2": {
          "type": "embed",
          "dimensions": 768,
          "maxTokens": 512,
          "quantized": false
        }
      }
    }
  },

  "chunkers": {
    "treesitter":           { "chunkSize": 1500, "chunkOverlap": 200 },
    "recursive-character":  { "chunkSize": 1000, "chunkOverlap": 200 },
    "markdown":             { "chunkSize": 1000, "chunkOverlap": 100 }
  },

  "vectorDBs": {
    "chromadb": {
      "url": "http://127.0.0.1:8000",
      "collection": "agentic-ai",
      "ssl": false,
      "tenant": "default_tenant",
      "database": "default_database",
      "distanceMetric": "cosine",
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json"
      }
    }
  },

  "search": {
    "topK": 5,
    "scoreThreshold": 0.65
  },

  "indexing": {
    "include": ["**/*.js", "**/*.mjs", "**/*.ts", "**/*.py", "**/*.jsx", "**/*.tsx"],
    "exclude": ["**/node_modules/**", "**/dist/**", "**/coverage/**", "**/.git/**", "**/build/**"],
    "batchSize": 50
  }
}
